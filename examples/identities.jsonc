// Replace these GitHub usernames and email addresses with your own.
// Identity names are case-insensitive; usernames and accepted emails must be unique.
{
  "personal": {
    "username": "alice",
    "commit": {
      "name": "Alice Example",
      "email": "alice@example.com",
      // Also accept historical commits with this address.
      "additional_emails": ["123+alice@users.noreply.github.com"]
    }
  },
  "school": {
    "username": "bob",
    "commit": {
      // Omitted name defaults to the GitHub username.
      "email": "bob@example.edu"
    }
  },
  "work": {
    "username": "carol",
    "commit": {
      "name": "Carol Example",
      "email": "carol@example.org"
    }
  }
}
