# PROPOSAL ONLY. These interfaces and paths are not implemented yet.
# Ownership, interfaces and invariants: architecture-proposal.md.
# Arrows show proposed dependencies; containment shows implementation privacy.
# Render using D2 0.9.0:
#   d2 specs/architecture-proposal.d2 specs/architecture-proposal.svg
#   d2 specs/architecture-proposal.d2 specs/architecture-proposal.png

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 32
  }
}
direction: down
classes: {
  boundary: {
    style: {
      fill: "#F8FAFC"
      stroke: "#94A3B8"
      border-radius: 12
      font-size: 20
    }
  }
  interface: {
    style: {
      fill: "#EFF6FF"
      stroke: "#2563EB"
      border-radius: 8
      font-size: 17
    }
  }
  deep: {
    style: {
      fill: "#ECFDF5"
      stroke: "#059669"
      border-radius: 8
      font-size: 17
    }
  }
  private: {
    style: {
      fill: "#F5F3FF"
      stroke: "#8B5CF6"
      border-radius: 8
      font-size: 16
    }
  }
  external: {
    style: {
      fill: "#FFF7ED"
      stroke: "#EA580C"
      border-radius: 8
      font-size: 16
    }
  }
}

title: "PROPOSED / multigh architecture\nExplicit behavior contracts · narrow interfaces · private implementation" {
  shape: text
  near: top-center
  style.font-size: 26
}

adapters: "CLI and terminal adapters" {
  class: boundary
  direction: right
  cli: "main.rs + cli.rs\nSpecified command surface" {class: interface}
  commands: "commands::run\nSingle dispatcher + small adapters" {class: interface}
  terminal: "presentation/\ncliclack prompts, semantic reports\nColors, padding and native streams" {class: interface}
  cli -> commands: "dispatches parsed command"
  commands -> terminal: "provides terminal implementation"
}

application: "application / approved public surface above private implementation" {
  class: boundary
  facade: "Named workflow operations + opaque RepositoryActions\ncreate/edit/remove · setup · switch · repo actions\npreferences · entry · inspection · hook · Git forwarding" {class: interface}
  interaction: "Prompts + Reports contracts\nTyped answers / cancellation\nProgress at operation stages" {class: interface}
  workflows: "Private workflows/\nValidation and effect ordering\nPartial completion and recovery\nNo eager global initialization" {class: private}

  domain: "Private deep modules" {
    class: boundary
    identities: "identities/\nCatalog · resolve · prepare · save\nHides JSONC, validation and atomic editing" {class: deep}
    accounts: "accounts/\nSelected vs live observations\nEnsure login · switch\nHides gh protocol and failures" {class: deep}
    preferences: "preferences\nNamed preference reads/writes\nFirst-setup state\nHides paths, markers and permissions" {class: deep}
    repositories: "repositories/\nInspect · permissions · protections\nSelection · integration · hooks\nHides Git scopes, policy, history\nand hook installation / forwarding" {class: deep}
  }
  platform: "Private platform/\nProcess I/O and filesystem mechanics\nNo policy or authorization decisions" {class: private}

  facade -> workflows: "delegates complete operations"
  workflows -> interaction: "requests input / reports progress"
  workflows -> domain.identities: "validated catalog and prepared changes"
  workflows -> domain.accounts: "explicit account operation"
  workflows -> domain.preferences: "global preferences only"
  workflows -> domain.repositories: "semantic repository / integration operation"
  domain.identities -> platform: "private file persistence"
  domain.preferences -> platform: "private marker persistence"
  domain.accounts -> platform: "gh I/O"
  domain.repositories -> platform: "Git / hook I/O and generated files"
}

outside: "External integration contracts" {
  class: boundary
  files: "Private JSONC + multigh state\nSpecified schema, paths and permissions" {class: external}
  tools: "Git + GitHub CLI + project hooks\nScoped config and native arguments\nInput replay and failure behavior" {class: external}
}

adapters.commands -> application.facade: "calls approved operations only"
adapters.terminal -> application.interaction: "implements contracts"
application.platform -> outside.files: "reads / writes"
application.platform -> outside.tools: "executes / captures / inherits I/O"
